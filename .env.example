# 복사해서 .env 로 쓴다 (.env 는 git 에서 제외). 셸 환경 변수가 있으면 그쪽이 우선.

# ── 토스증권 Open API (없으면 샘플 시세로만 동작, 주문 불가) ──
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
# 주문 PIN (4자리 이상). 화면·API 로는 못 바꾼다. 비우면 주문·에이전트 세션을 시작할 수 없다.
MIA_TRADING_PIN=
# 자동 운용 켜기(1) · 끄기(0) — 켜면 승인 없이 실계좌로 주문한다. 서버가 20초마다 이 파일을 다시 읽어서 고치면 바로 따른다.
# 화면의 켜기 · 끄기(PIN 없이)도 이 줄을 고친다.
MIA_AUTOPILOT=0

# 거래 기록 시작일 (YYYY-MM-DD) — 이 날 전 토스 체결은 가져오지도 남기지도 않는다 (이미 있으면 지움). 비우면 전부
MIA_TRADES_SINCE=

# ── OpenDART (가치평가 재무, 선택) ──
DART_API_KEY=

# ── LLM ──
# Claude Agent SDK: 비우면 로컬 Claude Code 로그인, 있으면 API 키
ANTHROPIC_API_KEY=
MIA_LLM_MODEL=claude-opus-5-5
# vLLM (OpenAI 호환 서버) — 예: http://127.0.0.1:8001/v1
MIA_VLLM_URL=
MIA_VLLM_API_KEY=

# ── LangSmith 로 트레이스 내보내기 (선택, `uv sync --extra langsmith`) ──
# 켜면 프롬프트(보유 종목 · 운용 목표)가 LangSmith 서버로 간다 → 키와 함께 MIA_LANGSMITH_EXPORT=1 을 직접 켜야 동작
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mallot-invest-agent
MIA_LANGSMITH_EXPORT=0
# MIA_TRACE=0      # 호출 추적(trace_spans) 끄기

# ── 접근 권한 (인터넷에 열 때 필수, docs/share.md) ──
# 관리자 비밀번호 해시 — `cd backend && uv run python -m app.auth.passwd` 가 넣는다 (평문 MIA_ADMIN_PASSWORD 도 되지만 비추천)
MIA_ADMIN_PASSWORD_HASH=
# 1 이면 로그인을 언제나 요구 (scripts/share.sh 가 켠다). 쿠키 서명 비밀은 비우면 data/session_secret 을 만든다
# MIA_PUBLIC=1
# MIA_SESSION_SECRET=

# ── 실행 ──
# MIA_DB_PATH=./data/invest.db   # DB 위치 (실행 산출물도 이 폴더 아래 runs/ 에)
# MIA_MODELS_DIR=~/path/to/models  # 이미 받은 로컬 LLM 모델 폴더를 같이 쓸 때
# MIA_SERVICES=0   # 백그라운드 서비스(자동 운용 일정 등) 끄기
